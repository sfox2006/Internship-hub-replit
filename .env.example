PORT=3000
# Optional absolute public origin for the demo calendar feed.
APP_URL=
# Public build-time clock. Set to "live" for the real current time.
VITE_REFERENCE_NOW=2026-10-08T13:23:00Z
# Used only after Replit Agent enables Auth and connects the verified identity adapter.
# Comma-separated stable Replit user IDs allowed administrator access; blank denies access.
ADMIN_REPLIT_USER_IDS=

# Private messaging. All values below and APP_URL are required to enable it.
# Register APP_URL/api/auth/callback as your provider's exact redirect URI.
# Use an OIDC provider which returns email_verified: true in validated ID tokens.
DATABASE_URL=
SESSION_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
