PORT=3000
# Optional absolute public origin for generated calendar links.
APP_URL=
# Public build-time clock. Set to "live" for the real current time.
VITE_REFERENCE_NOW=2026-10-08T13:23:00Z
# Replit-managed Clerk development keys are provisioned in Replit Secrets.
# Keep values blank here; never commit live credentials.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional Replit-managed Clerk proxy URL; provisioned automatically for production.
VITE_CLERK_PROXY_URL=

# Private messaging remains disabled until settings and provider access are verified.
# Set MESSAGING_ENABLED=true only after the authenticated OIDC provider and roster gate pass review.
# Register APP_URL/api/auth/callback as your provider's exact redirect URI.
# Use an OIDC provider which returns email_verified: true in validated ID tokens.
MESSAGING_ENABLED=false
DATABASE_URL=
SESSION_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
